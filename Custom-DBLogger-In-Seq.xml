<sequence name="Custom-DBLogger-In-Seq" xmlns="http://ws.apache.org/ns/synapse">
<property name="currentApiName" expression="get-property('API_NAME')" type="STRING"/>
    <property name="migrationListXml" expression="get-property('MigrationAPIList')" type="OM"/>
    <property name="isMigrationAPI" 
              expression="boolean($ctx:migrationListXml//*[local-name()='api'][text() = $ctx:currentApiName])" 
              type="STRING"/>

    <log level="custom">
        <property name="DEBUG_STATUS" value="--- Checking Migration API List ---"/>
        <property name="DEBUG_CURRENT_API" expression="$ctx:currentApiName"/>
    </log>

    <filter source="$ctx:isMigrationAPI" regex="true">
        <then>
            
            <!-- 🌟 1. ดึงข้อมูล Count ล่าสุดมา -->
            <dblookup>
                <connection>
                    <pool>
                        <driver>org.postgresql.Driver</driver>
                        <url>jdbc:postgresql://10.224.146.29:5551/cpidev</url>
                        <user>cpiadmin</user>
                        <password>zQ3!U#4gB_J1H4tw</password>
                    </pool>
                </connection>
                <statement>
                    <sql><![CDATA[SELECT count AS apicount FROM public.api WHERE apiname = ?]]></sql>
                    <parameter expression="$ctx:currentApiName" type="VARCHAR"/>
                    <result name="apiHitCount" column="apicount"/>
                </statement>
            </dblookup>

            <!-- 🌟 2. ตัวแปรเก็บสถานะว่า "เกินโควต้าหรือยัง?" (Default = false) -->
            <property name="IS_COUNT_LIMIT_REACHED" value="false" type="STRING"/>
            
            <!-- 🌟 3. ถ้าแปลงตัวเลขแล้วมีค่า >= 10 ถึงจะอัปเดตสถานะเป็น true -->
            <filter xpath="boolean($ctx:apiHitCount) and number($ctx:apiHitCount) &gt;= 10">
                <then>
                    <property name="IS_COUNT_LIMIT_REACHED" value="true" type="STRING"/>
                </then>
            </filter>

            <!-- 🌟 4. กรองการทำงาน: จะบันทึกก็ต่อเมื่อยังไม่ถึง Limit (false) -->
            <filter source="$ctx:IS_COUNT_LIMIT_REACHED" regex="false">
                <then>
                    <!-- ส่ง Flag นี้ไปให้ Out-Seq เพื่อรับรู้ว่าต้องอัปเดตต่อ -->
                    <property name="IS_MIGRATION_LOGGED" value="true" type="STRING"/>
                    
                    <log level="custom">
                        <property name="DEBUG_STATUS" value="--- API Matched &amp; Count &lt; 10! Saving to DB ---"/>
                        <property name="CURRENT_COUNT" expression="$ctx:apiHitCount"/>
                    </log>
                    
                    <property name="reqStartTimeMs" expression="get-property('SYSTEM_TIME')" scope="default" type="LONG"/>
                    <property name="requestTime" expression="get-property('SYSTEM_DATE', 'yyyy-MM-dd HH:mm:ss.SSS')" type="STRING"/>
                    <property name="apiName" expression="get-property('API_NAME')" type="STRING"/>
                    <property name="apiVersion" expression="get-property('API_VERSION')" type="STRING"/>
                    <property name="fullUrl" expression="get-property('To')" type="STRING"/>
                    <property name="resourcePath" expression="get-property('axis2', 'REST_URL_POSTFIX')" type="STRING"/>
                    <property name="httpMethod" expression="$axis2:HTTP_METHOD" type="STRING"/>
                    <property name="ReqMessageID" expression="get-property('MessageID')" scope="default" type="STRING"/>
                    <property name="contentType" expression="$trp:Content-Type" type="STRING"/>
                    <property name="clientIp" expression="get-property('axis2', 'REMOTE_ADDR')" type="STRING"/>
                    
                    <property name="appName" expression="get-property('api.ut.application.name')" type="STRING"/>
                    <property name="userId" expression="get-property('api.ut.userId')" type="STRING"/>
                    <property name="clientId" expression="get-property('api.ut.consumerKey')" type="STRING"/>
                    
                    <sequence key="Capture-Payload-Seq"/>
                    <property name="reqPayload" expression="$ctx:capturedPayload" type="STRING"/>
                    <property name="reqPayloadFormat" expression="$ctx:capturedPayloadFormat" type="STRING"/>
                    
                    <!-- เก็บ Transport Header ทั้งหมดเป็น JSON (mask ค่า credential) เพื่อใช้ replay ใน unit test -->
                    <script language="js"><![CDATA[
                        var SENSITIVE = ["authorization", "cookie", "x-api-key", "apikey"];
                        var headers = mc.getAxis2MessageContext().getProperty("TRANSPORT_HEADERS");
                        var out = {};
                        if (headers != null) {
                            var it = headers.keySet().iterator();
                            while (it.hasNext()) {
                                var key = String(it.next());
                                var value = String(headers.get(key));
                                if (SENSITIVE.indexOf(key.toLowerCase()) >= 0) {
                                    value = "***MASKED***";
                                }
                                out[key] = value;
                            }
                        }
                        mc.setProperty("reqHeadersJson", JSON.stringify(out));
                    ]]></script>

                    <dbreport>
                        <connection>
                            <pool>
                                <driver>org.postgresql.Driver</driver>
                                <url>jdbc:postgresql://10.224.146.29:5551/cpidev</url>
                                <user>cpiadmin</user>
                                <password>zQ3!U#4gB_J1H4tw</password>
                            </pool>
                        </connection>
                        <statement>
                            <sql><![CDATA[
                                INSERT INTO public.api_request_log_for_migration
                                (MESSAGE_ID, API_NAME, API_VERSION, FULL_URL, RESOURCE_PATH, HTTP_METHOD, CONTENT_TYPE, CLIENT_IP, APP_NAME, USER_ID, CLIENT_ID, REQUEST_HEADERS, REQUEST_DATA, REQUEST_FORMAT, REQUEST_TIME) 
                                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CAST(? AS TIMESTAMP))
                            ]]></sql>
                            <parameter expression="$ctx:ReqMessageID" type="VARCHAR"/>
                            <parameter expression="$ctx:apiName" type="VARCHAR"/>
                            <parameter expression="$ctx:apiVersion" type="VARCHAR"/>
                            <parameter expression="$ctx:fullUrl" type="VARCHAR"/>
                            <parameter expression="$ctx:resourcePath" type="VARCHAR"/>
                            <parameter expression="$ctx:httpMethod" type="VARCHAR"/>
                            <parameter expression="$ctx:contentType" type="VARCHAR"/>
                            <parameter expression="$ctx:clientIp" type="VARCHAR"/>
                            <parameter expression="$ctx:appName" type="VARCHAR"/>
                            <parameter expression="$ctx:userId" type="VARCHAR"/>
                            <parameter expression="$ctx:clientId" type="VARCHAR"/>
                            <parameter expression="$ctx:reqHeadersJson" type="VARCHAR"/>
                            <parameter expression="$ctx:reqPayload" type="VARCHAR"/>
                            <parameter expression="$ctx:reqPayloadFormat" type="VARCHAR"/>
                            <parameter expression="$ctx:requestTime" type="VARCHAR"/> 
                        </statement>
                    </dbreport>
                </then>
                <else>
                    <log level="custom">
                        <property name="DEBUG_STATUS" value="--- Limit Reached! (Count &gt;= 10). Skipping DB Log. ---"/>
                        <property name="API_NAME" expression="$ctx:currentApiName"/>
                        <property name="CURRENT_COUNT" expression="$ctx:apiHitCount"/>
                    </log>
                </else>
            </filter>
        </then>
        <else>
            <!-- ไม่ตรงกับ List ระบบปล่อยผ่าน -->
        </else>
    </filter>
</sequence>
      <bpmndi:BPMNEdge bpmnElement="SequenceFlow_3" id="BPMNEdge_SequenceFlow_3" sourceElement="BPMNShape_ServiceTask_RequestReply" targetElement="BPMNShape_EndEvent_1">
        <di:waypoint x="620.0" xsi:type="dc:Point" y="156.0"/>
